rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile: only the few numbers a player chooses to share.
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','code','share','upd','xp','lvl','streak','best','badges','week'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Your own friend list, private to you.
      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Friend codes: look up one code at a time, no listing.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Reminder settings and the push address. Only you can read or write yours.
    match /private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
